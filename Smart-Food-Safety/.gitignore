# Root .gitignore for FoodSafe AI
node_modules/
.env
.env.*
!.env.example
*.log
npm-debug.log*

# Build artifacts
frontend/dist/
frontend/dist-ssr/

# Database backups and dumps
*.sql
*.dump
backend/pre_phase1_backup.sql

# Uploaded evidence and local assets
backend/uploads/*
!backend/uploads/.gitkeep
backend/src/uploads/*
!backend/src/uploads/.gitkeep

# Testing artifacts & local screenshots
phase2-screenshots/
project-ui-screenshots/
tests-browser/screenshots/

# Editor / OS
.DS_Store
Thumbs.db
.vscode/
.idea/

