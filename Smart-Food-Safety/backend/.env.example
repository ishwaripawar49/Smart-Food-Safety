# ==========================================
# FOODSAFE AI — BACKEND ENVIRONMENT CONFIGURATION
# Copy to .env and configure for your environment.
# DO NOT COMMIT REAL CREDENTIALS TO VERSION CONTROL.
# ==========================================

# Server runtime mode: development | production | test
NODE_ENV=production
PORT=5000

# Security: JWT Signature Secret (minimum 32 characters in production)
JWT_SECRET=change_this_to_a_secure_random_64_character_hex_secret_in_production

# MySQL Database Connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=foodsafe_user
DB_PASSWORD=your_secure_database_password
DB_NAME=smart_food_safety

# Database Connection Pool Settings
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# Reverse Proxy Support (set to true if deployed behind Nginx / Cloudflare / ALB)
TRUST_PROXY=false

# Allowed Frontend Client Origins (comma-separated or single URL)
FRONTEND_URL=https://staging.foodsafe.org
ALLOWED_ORIGINS=https://staging.foodsafe.org,https://admin.staging.foodsafe.org
